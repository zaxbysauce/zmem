{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/zmem-launch.js\" session-start",
            "commandWindows": "node ${PLUGIN_ROOT}/hooks/zmem-launch.js session-start",
            "additionalContextLimit": 2000,
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/zmem-launch.js\" recall",
            "commandWindows": "node ${PLUGIN_ROOT}/hooks/zmem-launch.js recall",
            "additionalContextLimit": 2000,
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/zmem-launch.js\" capture-correction",
            "commandWindows": "node ${PLUGIN_ROOT}/hooks/zmem-launch.js capture-correction",
            "additionalContextLimit": 2000,
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/zmem-launch.js\" pretool-recall",
            "commandWindows": "node ${PLUGIN_ROOT}/hooks/zmem-launch.js pretool-recall",
            "additionalContextLimit": 2000,
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/zmem-launch.js\" convention-capture",
            "commandWindows": "node ${PLUGIN_ROOT}/hooks/zmem-launch.js convention-capture",
            "additionalContextLimit": 2000,
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/zmem-launch.js\" capture-failure",
            "commandWindows": "node ${PLUGIN_ROOT}/hooks/zmem-launch.js capture-failure",
            "additionalContextLimit": 2000,
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/zmem-launch.js\" reflect",
            "commandWindows": "node ${PLUGIN_ROOT}/hooks/zmem-launch.js reflect",
            "additionalContextLimit": 2000,
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/zmem-launch.js\" subagent-recall",
            "commandWindows": "node ${PLUGIN_ROOT}/hooks/zmem-launch.js subagent-recall",
            "additionalContextLimit": 2000,
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/zmem-launch.js\" subagent-reflect",
            "commandWindows": "node ${PLUGIN_ROOT}/hooks/zmem-launch.js subagent-reflect",
            "additionalContextLimit": 2000,
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/zmem-launch.js\" precompact",
            "commandWindows": "node ${PLUGIN_ROOT}/hooks/zmem-launch.js precompact",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
