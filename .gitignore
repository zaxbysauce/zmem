# Plugin data (created at runtime — never commit)
*.sqlite
*.sqlite-wal
*.sqlite-shm

# OS noise
.DS_Store
Thumbs.db

# Editor noise
*.swp
*.swo
*~

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Embedding model binary (~90MB, Phase 10 — PLAN.md §7-P10). Lazy-downloaded
# by skills/memory/scripts/embeddings.py (checksum-verified) on first use, or
# already present on an existing install. NOT committed: it bloats every
# clone and every git operation. tokenizer.json + config.json are small and
# stay tracked. See embeddings.py module docstring for the fail-open
# behavior when this file is absent.
skills/memory/models/minilm.onnx
skills/memory/models/*.part

# ZCode working state (trace artifacts, never commit)
.zcode/

# Swarm/review working state (issue #38 I12 — review runs write here)
.swarm/

# Durable-session-state trace artifacts from agent runs (same never-commit
# intent as .zcode/; the committed manifest under .agents/plugins/ stays
# tracked — this excludes only the trace tree)
.agents/issue-traces/

# External graphify tool cache (generated by the operator's graphify workspace;
# never read by repo code, and its keys embed absolute home paths)
graphify-out/
.tmp-tests/

# Offline eval scratch (issue #64): CI builds the eval corpus store + report
# here; the report is uploaded as a workflow artifact, never committed.
.eval-tmp/

# Session scratch (isolated test stores / probe scripts) — never committed.
/tmp/

# Issue #82 self-corpus probe reports (may embed operator content)
self-corpus-results.json
