*.sh text eol=lf
*.js text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
# Issue #184 fixtures are byte-regenerated by tests on every platform.  Keep
# text formats (including YAML and sentinel TXT files) LF-stable under
# Windows autocrlf so committed bytes match the generator output.
tests/fixtures/hosts/** text eol=lf
# Decision-log fixtures are byte-contract inputs and must remain LF-stable on
# Windows as well as POSIX hosts.
tests/fixtures/decisions/*.log text eol=lf
# Large model files via Git LFS
*.onnx filter=lfs diff=lfs merge=lfs -text
skills/memory/models/tokenizer.json filter=lfs diff=lfs merge=lfs -text

# Local test fixture must stay a REAL file (pointers would break the gated
# real-inference test on machines with the runtime installed)
tests/fixtures/cross_encoder/*.onnx -filter -diff -merge -text
tests/fixtures/cross_encoder/tokenizer.json -filter -diff -merge -text

# Issue #159 prefetch fixtures pin exact ledger bytes; keep them LF on checkout.
tests/fixtures/prefetch/** text eol=lf
